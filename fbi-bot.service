[Unit]
Description=FBI-BOT headless Mumble recorder
After=network-online.target
Wants=network-online.target
# Allow endless restart retries (server down for hours)
StartLimitIntervalSec=0

[Service]
Type=simple
# Adjust User + WorkingDirectory to where you installed the bot
User=mumblebot
WorkingDirectory=/opt/fbi-mumble-bot
# Boot-only delay: wait 30s if the machine just booted (uptime < 3 min),
# so network/Murmur is up. Normal restarts later skip the sleep.
ExecStartPre=/bin/bash -c 'if [ $(cut -d. -f1 /proc/uptime) -lt 180 ]; then sleep 30; fi'
ExecStart=/opt/fbi-mumble-bot/venv/bin/python /opt/fbi-mumble-bot/bot.py -c /opt/fbi-mumble-bot/bot.conf
Restart=always
RestartSec=30
# Backstop: normal use stays well under 200MB (audio spills to disk, not RAM).
# If memory ever balloons again, restart cleanly instead of troubling the host.
MemoryMax=1G
# Keep journal tidy; bot logs REC START/STOP at warning level
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
